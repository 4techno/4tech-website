# Set this to the actual production HTTPS address before your production build.
# When absent on Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable only after the corresponding private backend is provisioned and tested.
NEXT_PUBLIC_PORTAL_UPLOADS_ENABLED=false
NEXT_PUBLIC_PORTAL_EMAIL_ENABLED=false

# Enable after deploying and validating workspace Firestore rules and indexes.
# Rebuild and republish after changing this public capability flag.
NEXT_PUBLIC_PORTAL_WORKSPACE_ENABLED=false

# Optional, consent-based visitor counts. Requires deployed callable + App Check.
NEXT_PUBLIC_PORTAL_ANALYTICS_ENABLED=false
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_PORTAL_FUNCTION_REGION=asia-south1

# Leave blank for the local planning worksheet. Set only after the AI worker passes
# a real verified-account test. Never place an AI secret or admin key here.
NEXT_PUBLIC_IDEA_API_URL=

# PROBE engineering companion: local worksheet until a protected /chat Worker
# is deployed, enabled and tested with a verified account.
NEXT_PUBLIC_ENGINEERING_API_URL=
